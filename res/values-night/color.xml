<resources>

    <!--
      Colours follow the system theme and dynamic colour: these are the dark theme's roles.
      -->

    <!-- Primary color (Color for the toolbars). -->
    <color name="calculator_primary_color">@android:color/system_primary_container_dark</color>

    <!-- Status bar color. -->
    <color name="calculator_statusbar_color">@android:color/system_surface_container_lowest_dark</color>

    <!-- Color to indicate an error has occured. -->
    <color name="calculator_error_color">@android:color/system_error_dark</color>

    <!-- Background color of the calculator display. -->
    <color name="display_background_color">@android:color/system_surface_container_lowest_dark</color>

    <!-- Text color for the formula in the calculator display. -->
    <color name="display_formula_text_color">@android:color/system_on_surface_dark</color>

    <!-- Text color for the result in the calculator display. -->
    <color name="display_result_text_color">@android:color/system_on_surface_variant_dark</color>

    <!-- Lighter color for exponent while scrolling. -->
    <color name="display_result_exponent_text_color">@android:color/system_outline_dark</color>

    <!-- Background color for the numeric pad. -->
    <color name="pad_numeric_background_color">@android:color/system_surface_container_lowest_dark</color>

    <!-- Background color for the operator pad. -->
    <color name="pad_operator_background_color">@android:color/system_surface_container_lowest_dark</color>

    <!-- Background color for the advanced pad. -->
    <color name="pad_advanced_background_color">@android:color/system_surface_container_high_dark</color>

    <!-- Key faces and labels whose roles are not Tally tokens. -->
    <color name="key_operator_color">@android:color/system_secondary_container_dark</color>
    <color name="key_operator_text_color">@android:color/system_on_secondary_container_dark</color>
    <color name="key_clear_color">@android:color/system_primary_container_dark</color>
    <color name="key_clear_text_color">@android:color/system_on_primary_container_dark</color>
    <color name="key_advanced_face_color">@android:color/system_surface_container_highest_dark</color>

    <!-- Background color for empty history view. -->
    <color name="empty_history_color">@android:color/system_surface_container_dark</color>

</resources>
